# Production: an HTTPS reverse proxy must terminate TLS. Node binds loopback.
PORT=8787
PUBLIC_URL=https://odoo-work.example.com
OIDC_ISSUER=https://identity.example.com/
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_AUDIENCE=https://odoo-work.example.com/mcp
# Register a public PKCE client for the setup page; configure ChatGPT as another client.
OIDC_CLIENT_ID=odoo-work-setup
OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.com/authorize
OIDC_TOKEN_ENDPOINT=https://identity.example.com/oauth/token
OIDC_SCOPES=openid odoo:read odoo:write
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
DATA_DIR=./data
# Exact DNS hostnames only. Configure centrally, never from model input.
ODOO_ALLOWED_HOSTS=yourcompany.odoo.com
# Private-network instances: explicitly approve their exact hostnames here too.
ODOO_PRIVATE_HOSTS=
