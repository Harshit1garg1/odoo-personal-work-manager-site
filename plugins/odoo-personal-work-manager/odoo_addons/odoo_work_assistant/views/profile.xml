<odoo>
  <record id="profile_list" model="ir.ui.view"><field name="name">odoo.work.profile.list</field><field name="model">odoo.work.profile</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id" groups="base.group_multi_company"/></list></field></record>
  <record id="profile_form" model="ir.ui.view"><field name="name">odoo.work.profile.form</field><field name="model">odoo.work.profile</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id"/></group><p>Map custom concepts, editable fields and verified workflow actions. Overrides replace a concept's full default mapping. Use the connector's custom-module guide.</p><field name="mapping_json" widget="ace" options="{'mode': 'json'}"/></sheet></form></field></record>
  <record id="profile_action" model="ir.actions.act_window"><field name="name">Work Assistant Mappings</field><field name="res_model">odoo.work.profile</field><field name="view_mode">list,form</field></record>
  <menuitem id="work_admin_menu" name="Work Assistant" groups="base.group_system"/>
  <menuitem id="profile_menu" name="Company Mappings" parent="work_admin_menu" action="profile_action" groups="base.group_system"/>
</odoo>
